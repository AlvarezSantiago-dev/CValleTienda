{
  "name": "cvalle-printbridge",
  "version": "1.0.0",
  "description": "Agente de impresión térmica local para CValleTienda",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "install-service": "node src/service.js install",
    "uninstall-service": "node src/service.js uninstall",
    "status-service": "node src/service.js status",
    "build": "pkg . --compress GZip"
  },
  "pkg": {
    "scripts": "src/**/*.js",
    "assets": [
      "public/**/*"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "node-thermal-printer": "^4.4.1",
    "node-windows": "^1.0.0-beta.8",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
